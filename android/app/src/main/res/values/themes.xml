<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- the window paints the page background, so nothing flashes white
         between the native screens and the web UI -->
    <style name="Glane" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>
</resources>
